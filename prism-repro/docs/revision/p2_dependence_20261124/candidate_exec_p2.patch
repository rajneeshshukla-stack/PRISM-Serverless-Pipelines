+def exec_mult(z: np.ndarray, cfg: PipelineConfig, rng_common=None) -> np.ndarray:
+    """Execution multipliers from per-stage standard normals z (stage axis last). With exec_common_frac = rho > 0,
+    one common normal per request (from `rng_common`, a separate stream) is mixed in: sqrt(rho) z_c + sqrt(1-rho) z.
+    rho = 0 returns lognormal_mult(z, exec_shape) exactly (legacy draws unchanged)."""
+    rho = float(getattr(cfg, "exec_common_frac", 0.0))
+    if rho == 0.0:
+        return lognormal_mult(z, cfg.exec_shape)
+    if rng_common is None:
+        raise ValueError("exec_common_frac > 0 needs a separate random stream for the common factor")
+    zc = rng_common.standard_normal(z.shape[:-1] + (1,))
+    return lognormal_mult(np.sqrt(rho) * zc + np.sqrt(1.0 - rho) * z, cfg.exec_shape)
+
+
 def lognormal_mult(z: np.ndarray, sigma: float) -> np.ndarray:
     """Mean-one log-normal multiplier exp(sigma z - sigma^2/2) (D01)."""
     return np.exp(sigma * z - 0.5 * sigma * sigma)
